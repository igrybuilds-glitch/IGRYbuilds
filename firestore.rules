rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'igrybuilds@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    // Entity Validation: ProjectBrief
    function isValidProjectBrief(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.clientName is string && data.clientName.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
             (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 128)) &&
             data.serviceType is string && data.serviceType.size() <= 64 &&
             (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 64)) &&
             (!('timeline' in data) || (data.timeline is string && data.timeline.size() <= 64)) &&
             data.description is string && data.description.size() <= 2000 &&
             data.status in ['submitted', 'reviewing', 'architecture_ready', 'scheduled'];
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Collection: Briefs
    match /briefs/{briefId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(briefId) && isValidProjectBrief(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isSignedIn() && existing().userId == request.auth.uid && isValidId(briefId) && isValidProjectBrief(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time) || isAdmin();
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }
  }
}
